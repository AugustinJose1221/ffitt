    "views": [
      {
        "id": "the-idea",
        "label": "A row of peaks repeats too",
        "focus": [
          "signal",
          "harmonics"
        ],
        "note": "Harmonics stand evenly apart in the spectrum. A row of evenly spaced peaks is itself a thing that repeats."
      },
      {
        "id": "the-log",
        "label": "Why the logarithm",
        "focus": [
          "log",
          "again"
        ],
        "note": "A source passing through a shape is a multiplication in the spectrum, and a logarithm turns that into a sum."
      },
      {
        "id": "quefrency",
        "label": "Quefrency is a time",
        "focus": [
          "peak",
          "note"
        ],
        "note": "A peak at quefrency 80 says the harmonics stand rate/80 apart, thus the note repeats every 80 samples."
      },
      {
        "id": "splitting",
        "label": "Source from shape",
        "focus": [
          "slowfast"
        ],
        "note": "The slow part of the log spectrum is the shape it passed through, and the fast part is the source."
      }
    ]
  },
