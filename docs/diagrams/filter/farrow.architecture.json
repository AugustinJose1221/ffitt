  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = sum over k of c_k(mu) * x[n-k], with mu the fraction of a sample",
        "A delay of a whole number of samples is free; a part of one is a filter",
        "The value between two samples is not in the reading and must be worked out"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the structure avoids",
      "items": [
        "c_k(mu) = a0_k + a1_k*mu + a2_k*mu^2 + ...",
        "The a values are fixed and worked out one time",
        "A new fraction costs only the evaluation of those small polynomials"
      ]
    },
    {
      "dot": "amber",
      "title": "What it is for",
      "items": [
        "Lining two readings up after delay_by_phase has measured the offset",
        "Steering an array of microphones, and resampling by a ratio that is not whole",
        "Following a clock that drifts, where the fraction changes at every sample"
      ]
    }
  ]
