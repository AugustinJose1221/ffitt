  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "minimise sum over i of (y[i] - p(x[i]))^2",
        "Setting the derivative to nothing gives (A' * A) * c = A' * y",
        "A holds a power of x in each column"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "A' * A = L * L', the factor of Cholesky",
        "That turns one square problem into two triangular ones",
        "Walk down the triangle, then back up through the transpose, which is never formed"
      ]
    },
    {
      "dot": "amber",
      "title": "Why the places are moved",
      "items": [
        "A power of a large x runs out of digits quickly",
        "The places are held about a centre and a width rather than as they came",
        "That is what keeps the fit from failing on readings far from the origin"
      ]
    }
  ]
