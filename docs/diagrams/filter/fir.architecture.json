        "id": "no-feedback",
        "label": "No feedback at all",
        "focus": [
          "sample",
          "weigh",
          "out"
        ],
        "note": "Nothing the filter has produced comes back in. That is why it cannot run away, whatever the coefficients are."
      },
      {
        "id": "the-shape",
        "label": "Why the shape survives",
        "focus": [
          "out",
          "shape"
        ],
        "note": "Every frequency is held back by the same time, half the length of the filter. Thus the shape of a signal comes through unchanged."
      },
      {
        "id": "the-design",
        "label": "Where coefficients come from",
        "focus": [
          "sinc",
          "window",
          "coeffs"
        ],
        "note": "The ideal filter is a sinc that runs for ever. A window cuts it to a length that can be held."
      },
      {
        "id": "the-cost",
        "label": "What it costs",
        "focus": [
          "coeffs",
          "taps"
        ],
        "note": "For the same sharpness this needs dozens of coefficients where a biquad needs five."
      }
    ]
  },
