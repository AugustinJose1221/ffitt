  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "mean = sum over i of x[i] / n, and variance from that",
        "median = the middle value once the list is in order",
        "mad = the median of |x[i] - median|"
      ]
    },
    {
      "dot": "emerald",
      "title": "Which to reach for",
      "items": [
        "The plain measures read the list once and follow every sample",
        "One sample that is wrong moves all of them",
        "Nearly half the list may be wrong before a median moves at all"
      ]
    },
    {
      "dot": "amber",
      "title": "The bridge between them",
      "items": [
        "STATS_MAD_TO_DEVIATION is 1.4826",
        "Multiplying the MAD by it gives what a deviation means for the usual shape",
        "Thus a threshold in deviations can be set from data that already holds faults"
      ]
    }
  ]
