  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "q = w + x*i + y*j + z*k, with w^2 + x^2 + y^2 + z^2 = 1",
        "Turning by one attitude then another is q3 = q1 * q2",
        "Turning a vector is v' = q * v * conjugate(q)"
      ]
    },
    {
      "dot": "rose",
      "title": "Why not three angles",
      "items": [
        "At one attitude two of the three axes line up",
        "A turn about one and a turn about another then do the same thing",
        "No arrangement of the axes removes the fault; it only moves it elsewhere"
      ]
    },
    {
      "dot": "amber",
      "title": "What it costs you",
      "items": [
        "The four numbers must keep a length of one",
        "Rounding slowly breaks that constraint",
        "Thus the length must be brought back to one from time to time"
      ]
    }
