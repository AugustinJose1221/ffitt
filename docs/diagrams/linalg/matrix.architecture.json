        "note": "The element at row i and column j lies at position (i*n)+j. Everything else in the module follows from that one line."
      },
      {
        "id": "walking",
        "label": "Rows are cheap, columns are not",
        "focus": [
          "row",
          "column"
        ],
        "note": "Walking a row is walking through memory in order. Walking a column steps n values at a time."
      },
      {
        "id": "the-ops",
        "label": "The plain operations",
        "focus": [
          "ops"
        ],
        "note": "Add element by element, multiply as a sum over k, transpose by swapping the indices. No tricks."
      },
      {
        "id": "two-roads",
        "label": "Heap or your own memory",
        "focus": [
          "heap",
          "given"
        ],
        "note": "One allocator takes memory from the heap and one takes memory you already hold, thus a target with no heap loses nothing."
      }
    ]
  },
