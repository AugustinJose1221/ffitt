    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "Put Q-1 zeros between the samples, which raises the rate by Q",
        "Filter, at that higher rate",
        "Keep every Pth sample, which lowers the rate by P"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the filter is not optional",
      "items": [
        "Going up, it fills in the zeros, which are not samples of anything",
        "Going down, it removes everything above half the NEW rate first",
        "One filter does both jobs, because both are the same job at different ends"
      ]
    },
    {
      "dot": "rose",
      "title": "What cannot be undone",
      "items": [
        "A signal at 32 kHz may hold up to 16 kHz; at 500 Hz nothing above 250 fits",
        "What was above 250 comes back at a frequency it never had",
        "It then sits on top of the signal and looks exactly like part of it"
      ]
