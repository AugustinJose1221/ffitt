    "views": [
      {
        "id": "too-small",
        "label": "Smaller than the noise",
        "focus": [
          "single"
        ],
        "note": "A threshold low enough to catch the change fires on the noise all day; one high enough to be quiet never fires."
      },
      {
        "id": "adding-up",
        "label": "Evidence adds up",
        "focus": [
          "total",
          "slack"
        ],
        "note": "A total that only grows when readings lean one way. Ordinary readings push it down as often as up."
      },
      {
        "id": "two-totals",
        "label": "Two totals, not one",
        "focus": [
          "up",
          "down"
        ],
        "note": "A total that only grows upward cannot see a reading that has dropped, thus a second one runs for the fall."
      },
      {
        "id": "the-trade",
        "label": "Sooner, or fewer alarms",
        "focus": [
          "thresh"
        ],
        "note": "A smaller threshold finds the change sooner and gives more false alarms. That is the trade, not a fault to tune away."
      }
    ]
  },
