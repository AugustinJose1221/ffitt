  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "X[m][k] = sum over n of x[n + m*hop] * w[n] * exp(-2*pi*i*k*n/block)",
        "m counts the blocks and is the moment; k counts the bins and is the frequency",
        "One transform of the whole recording says what, and nothing about when"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "The hop is how far the window moves between blocks",
        "A hop of half the block makes the windows add up to a constant",
        "What the window takes at the edge of one block is put back by the next"
      ]
    },
    {
      "dot": "amber",
      "title": "The trade nobody escapes",
      "items": [
        "A block of n samples at rate r covers n/r seconds",
        "Its bins stand r/n hertz apart, and the product of the two is 1",
        "A short block says when and not what; a long block says what and not when"
      ]
    }
  ]
