          "error"
        ],
        "note": "Every other filter here is designed and then applied. This one is given an answer to aim at and finds its own coefficients."
      },
      {
        "id": "the-step",
        "label": "One step per sample",
        "focus": [
          "step",
          "coeffs"
        ],
        "note": "Each coefficient moves a little towards whatever would have been right, in proportion to the sample that drove it."
      },
      {
        "id": "which-rule",
        "label": "Which rule to take",
        "focus": [
          "rules"
        ],
        "note": "Plain moves further when the signal is loud. Normalised divides that out. Sign takes a fixed step and needs no multiplication."
      },
      {
        "id": "the-leak",
        "label": "Why coefficients leak",
        "focus": [
          "leak"
        ],
        "note": "A coefficient that nothing is driving would wander away over hours. The leak pulls every one gently towards nothing."
      }
    ]
