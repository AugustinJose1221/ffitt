  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "gain = P*x / (forgetting + x'*P*x)",
        "h = h + gain * (wanted[n] - h'*x)",
        "P = (P - gain*x'*P) / forgetting"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "P is the inverse of the correlation matrix, carried forward and never found again",
        "A fresh solution would cost the cube of the length at every sample",
        "Carrying P costs the square, which is what makes this affordable at all"
      ]
    },
    {
      "dot": "amber",
      "title": "What it buys and what it costs",
      "items": [
        "On 16 coefficients, 40 dB towards the truth in about twice the length in samples",
        "The normalised least mean squares needed 163 samples for the same",
        "A long filter costs far more memory and work here than the adaptive module asks"
      ]
    }
  ]
