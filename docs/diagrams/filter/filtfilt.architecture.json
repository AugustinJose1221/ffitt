    "views": [
      {
        "id": "the-fault",
        "label": "Why a filter bends a shape",
        "focus": [
          "forward",
          "bent"
        ],
        "note": "A filter with feedback delays each frequency by a different amount, thus the parts arrive at different times and no longer line up."
      },
      {
        "id": "both-ways",
        "label": "Run it both ways",
        "focus": [
          "reverse",
          "backward"
        ],
        "note": "Whatever the filter held back going forward it holds back again going back. The two shifts are equal and opposite."
      },
      {
        "id": "twice",
        "label": "The band is taken twice",
        "focus": [
          "twice"
        ],
        "note": "The filter is applied twice, thus the edge is sharper than the design asks and the stop band is deeper again."
      },
      {
        "id": "not-live",
        "label": "Never for a live signal",
        "focus": [
          "whole"
        ],
        "note": "The whole block must be in hand before the backward pass can start."
      }
    ]
  },
