      {
        "id": "the-danger",
        "label": "What folds back",
        "focus": [
          "fold"
        ],
        "note": "A signal at 32 kHz may hold 16 kHz. At 500 Hz nothing above 250 fits, and what was above it comes back at a frequency it never had."
      },
      {
        "id": "three-steps",
        "label": "Three steps, not one",
        "focus": [
          "up",
          "filterit",
          "down"
        ],
        "note": "Put Q-1 zeros between the samples, filter at the higher rate, then keep every Pth sample."
      },
      {
        "id": "two-jobs",
        "label": "One filter, two jobs",
        "focus": [
          "filterit"
        ],
        "note": "On the way up it fills the zeros, which are samples of nothing. On the way down it removes what would fold back."
      },
      {
        "id": "never-really",
        "label": "Never really done that way",
        "focus": [
          "cheap"
        ],
        "note": "The zeros are not inserted and the thrown samples are not worked out. Only the outputs that are kept are computed."
      }
    ]
  },
