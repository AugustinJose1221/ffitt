  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "c[q] = inverse transform of log(|X[k]|)",
        "A row of harmonics standing evenly apart comes out as ONE peak",
        "The place of that peak is a time, and it is called quefrency"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the logarithm is the whole trick",
      "items": [
        "A source passing through a shape is a MULTIPLICATION in the spectrum",
        "A logarithm turns a multiplication into a SUM",
        "The two can then be added apart, which no other road here offers"
      ]
    },
    {
      "dot": "amber",
      "title": "How to read the answer",
      "items": [
        "period in samples = quefrency",
        "note in hertz = rate / quefrency",
        "The slow part is the shape it passed through; the fast part is the source"
      ]
    }
  ]
