  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = the median of x[n-N+1] .. x[n]",
        "Nothing is added and nothing is multiplied",
        "The answer is always a value that really appeared in the signal"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why a mean cannot do this",
      "items": [
        "A mean of a window holding one wild value moves towards that value",
        "A median does not move at all until half the window is wrong",
        "One bad sample in a window of five changes the answer by nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "What it costs you",
      "items": [
        "The window must be put in order to find its middle",
        "Thus the work for each sample grows with the size of the window",
        "This is not the filter for a long window"
      ]
    }
