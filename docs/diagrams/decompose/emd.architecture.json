  "cards": [
    {
      "dot": "cyan",
      "title": "What one sift does",
      "items": [
        "Find every peak and every valley of the signal",
        "Lay a spline through the peaks, and another through the valleys",
        "Take the mean of those two envelopes away, and repeat"
      ]
    },
    {
      "dot": "emerald",
      "title": "What stops it",
      "items": [
        "A mode has as many crossings of zero as it has peaks and valleys",
        "Its envelopes sit about zero",
        "Then the whole loop runs again on the residue, and each mode is slower than the last"
      ]
    },
    {
      "dot": "rose",
      "title": "Strength and weakness together",
      "items": [
        "Nothing here is derived from a model; the signal decides the modes",
        "Thus it follows a signal that no fixed basis fits",
        "Where two frequencies sit close, one sift takes pieces of both, and that is not answered here"
      ]
    }
