  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = (1/N) * sum over k of x[n-k], the mean of the last N samples",
        "Worked out as it stands, that is N operations for each sample",
        "A window of 500 samples at 32 kHz would be 16 million operations a second"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "total = total + arrived - left, and y[n] = total / N",
        "One addition, one subtraction and one division, whatever N is",
        "The window is still held, because the sample that left must be known"
      ]
    },
    {
      "dot": "rose",
      "title": "What it costs you",
      "items": [
        "A total added to for ever gathers the rounding of every sample",
        "That is the price of the running total, and it is the whole of the price",
        "The total of the squares is kept too, thus the spread costs no more"
      ]
    }
  ]
