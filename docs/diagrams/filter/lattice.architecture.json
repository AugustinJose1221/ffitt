  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "forward[m+1] = forward[m] - k[m] * held[m]",
        "backward[m+1] = held[m] - k[m] * forward[m]",
        "k[m] moves towards whatever the two still have in common"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why a ladder learns quickly",
      "items": [
        "The step of a stage is divided by how loud that stage has been",
        "Thus each stage judges its own step against its own signal",
        "A straight list moves every coefficient against one rate and cannot do that"
      ]
    },
    {
      "dot": "amber",
      "title": "What will catch you",
      "items": [
        "The energy is a running SUM over a fading past, not a running mean",
        "Such a sum is about 1/(1-factor) times the mean",
        "At a factor of 0.99 it is a hundred times larger, and the rate must be read so"
      ]
    }
  ]
