        "id": "the-difference",
        "label": "Not one step downhill",
        "focus": [
          "gain",
          "solve"
        ],
        "note": "The adaptive module takes a small step with each sample. This solves the whole least squares problem at every sample."
      },
      {
        "id": "carried",
        "label": "P is carried, not found again",
        "focus": [
          "pmatrix"
        ],
        "note": "A fresh solution would cost the cube of the length every sample. Carrying the inverse costs the square."
      },
      {
        "id": "forgetting",
        "label": "Fading the past",
        "focus": [
          "forget"
        ],
        "note": "The forgetting factor lets the filter follow a response that changes, instead of averaging over all time."
      },
      {
        "id": "the-price",
        "label": "What it buys and costs",
        "focus": [
          "fast",
          "cost"
        ],
        "note": "About twice the number of coefficients in samples, against 163 for the normalised rule on a filter of 16."
      }
    ]
