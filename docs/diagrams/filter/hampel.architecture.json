      "label": "what it would cost"
    },
    {
      "id": "scaled",
      "from": "spread",
      "to": "test",
      "label": "the spread"
    },
    {
      "id": "asked",
      "from": "centre",
      "to": "test",
      "variant": "emphasis"
    },
    {
      "id": "passed",
      "from": "test",
      "to": "keep",
      "label": "within three",
      "variant": "emphasis"
    },
    {
      "id": "failed",
      "from": "test",
      "to": "out",
      "label": "beyond three",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "centre = the median of the window",
        "spread = 1.4826 * the median of |x[k] - centre|",
        "x[n] is replaced by centre only when |x[n] - centre| > 3 * spread"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the median of distances",
      "items": [
        "One wild value moves a mean and cannot move a median",
        "Thus the measure of what is normal is not bent by the fault it looks for",
        "The 1.4826 makes it equal the standard deviation for noise of the usual shape"
      ]
    },
    {
      "dot": "amber",
      "title": "What it does not do",
      "items": [
        "It does not touch a sample that passes the test",
        "A median filter would flatten the signal and lose every narrow peak",
        "This is a heavy price for a fault that happens once a second"
      ]
    }
  ]
}
