  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = x[n] - mean(x), for the level alone",
        "y[n] = x[n] - (a + b*n), for the level and the drift",
        "b is the slope the readings suggest, and a is where that line starts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why a block and not a stream",
      "items": [
        "A block can be measured from both ends at once",
        "Thus the line is the best one for that block, not a guess that follows behind",
        "dcblock does the same work for a stream, and must follow rather than measure"
      ]
    },
    {
      "dot": "rose",
      "title": "Why it matters more than it looks",
      "items": [
        "A transform reads a block as one period of something that repeats",
        "A block that ends higher than it began joins the next copy with a step",
        "That step is not in the signal, and its energy spreads across every frequency"
      ]
    }
  ]
