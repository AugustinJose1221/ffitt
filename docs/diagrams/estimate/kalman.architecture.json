    "views": [
      {
        "id": "two-steps",
        "label": "Predict, then update",
        "focus": [
          "predict",
          "update"
        ],
        "note": "One step moves the state forward and lets the uncertainty grow. The other pulls it back towards the measurement."
      },
      {
        "id": "the-gain",
        "label": "What the gain decides",
        "focus": [
          "gain"
        ],
        "note": "Where the measurement is noisy the gain is small and it barely moves the state. Where the model is doubtful the gain grows."
      },
      {
        "id": "no-memory",
        "label": "No memory while it runs",
        "focus": [
          "scratch"
        ],
        "note": "Every intermediate result goes in scratch matrices laid out at the allocation, thus a static filter needs no heap."
      },
      {
        "id": "refusal",
        "label": "When it refuses",
        "focus": [
          "singular"
        ],
        "note": "Where the innovation covariance cannot be inverted, the update is refused and the state is left as it was."
      }
    ]
  },
