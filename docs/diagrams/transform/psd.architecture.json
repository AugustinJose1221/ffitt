  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "P[k] = (1/blocks) * sum over b of |X_b[k]|^2 / (rate * U)",
        "The power a signal holds at each frequency, by the method of Welch",
        "One transform alone gives a bin as noisy as the signal, however long it is"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "Fewer, longer blocks: fine in frequency and noisy in size",
        "More, shorter blocks: coarse in frequency and steady in size",
        "4096 samples in 8 blocks of 1024 gives bins 8 times as wide and an answer 3 times as steady"
      ]
    },
    {
      "dot": "rose",
      "title": "The part usually got wrong",
      "items": [
        "U is the sum of the squares of the window, and it must be divided out",
        "Without it the answer depends on the window and not on the signal",
        "The scaling is what makes two measurements comparable at all"
      ]
    }
  ]
