  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "A decimator keeps one sample in every factor, after the filter",
        "An interpolator makes factor samples for each one it is given",
        "A ratio such as 44 100 to 48 000 is one of each, chained by the caller"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "The decimator works out its filter only for the samples it keeps",
        "The interpolator never puts the zeros in; each output reads every factor-th coefficient",
        "The filter comes before the keeping, or what lies above the new limit folds back"
      ]
    },
    {
      "dot": "rose",
      "title": "What the chain costs",
      "items": [
        "Counted at the advised lengths: 9 703 products for each sample given",
        "7 056 000 intermediate samples a second, of which 48 000 are kept",
        "A single filter that knew both factors would need about 33, near three hundred times less"
      ]
    }
