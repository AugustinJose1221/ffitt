    "views": [
      {
        "id": "the-fault",
        "label": "A sample can be wrong",
        "focus": [
          "spike",
          "mean"
        ],
        "note": "A knock, a lost sample, a spike from a supply: one value that has nothing to do with the signal. It does not average away."
      },
      {
        "id": "no-arithmetic",
        "label": "No arithmetic at all",
        "focus": [
          "order",
          "middle"
        ],
        "note": "Nothing is added and nothing is multiplied. The answer is always a value that really appeared in the signal."
      },
      {
        "id": "half-wrong",
        "label": "Half the window may be wrong",
        "focus": [
          "middle",
          "out"
        ],
        "note": "A mean moves towards a wild value. A median does not move until half the window is wrong."
      },
      {
        "id": "the-cost",
        "label": "What it costs",
        "focus": [
          "order"
        ],
        "note": "The window must be put in order to find its middle, thus the work grows with the size of the window."
      }
    ]
  },
