  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "level = level + pole * (x[n] - level)",
        "y[n] = x[n] - level",
        "The level is primed with the first sample, and not with zero"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why not a high pass",
      "items": [
        "A high pass from iir would do it, and for most signals it should",
        "At the default width a number holds about seven digits",
        "A converter of 24 bits near mid range spends six of them on the level"
      ]
    },
    {
      "dot": "amber",
      "title": "What it costs you",
      "items": [
        "One multiplication and two additions a sample, and one value of state",
        "The subtraction happens first, thus the chain after it sees the small signal",
        "Priming with the first sample is what keeps the first answer from being a step"
      ]
    }
  ]
