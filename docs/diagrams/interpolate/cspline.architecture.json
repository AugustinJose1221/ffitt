  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "S(x) = y[i] + b[i]*d + c[i]*d^2 + d[i]*d^3, with d = x - x[i]",
        "The arrays b, c and d hold one value per interval",
        "Thus they hold one value fewer than the number of points"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where the coefficients come from",
