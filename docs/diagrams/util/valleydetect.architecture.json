  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "A valley is x[n] < x[n-1] and x[n] < x[n+1]",
        "The first and the last sample are never valleys",
        "A signal of fewer than three samples holds no valley at all"
      ]
    },
    {
      "dot": "emerald",
      "title": "What it asks of you",
      "items": [
        "The index and the value of each valley go into buffers the caller holds",
        "Thus the function takes no memory of its own",
        "Both must have room for one valley for every other sample"
      ]
    },
    {
      "dot": "amber",
      "title": "What it does not do",
      "items": [
        "It judges none of what it finds",
        "Everything said of a peak applies here upside down",
        "Where the signal holds noise, most of what it finds will not be useful valleys"
