    "views": [
      {
        "id": "the-step",
        "label": "The step that is not there",
        "focus": [
          "block",
          "step"
        ],
        "note": "A transform reads the block as one period that repeats. A block ending higher than it began joins itself with a step."
      },
      {
        "id": "the-level",
        "label": "Taking the level off",
        "focus": [
          "mean",
          "level"
        ],
        "note": "The mean of the block is subtracted. That alone moves the block down to sit about zero."
      },
      {
        "id": "the-drift",
        "label": "Taking the drift off",
        "focus": [
          "line",
          "fit"
        ],
        "note": "A straight line is laid through the block by least squares, and that line is subtracted."
      },
      {
        "id": "both-ends",
        "label": "Why a block, not a stream",
        "focus": [
          "fit"
        ],
        "note": "A block can be measured from both ends, thus the line is the best one for it and not a guess that follows behind."
      }
    ]
  },
