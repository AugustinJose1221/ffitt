  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = sum over k of x[n-k] * h[k], as any finite filter does",
        "error = wanted[n] - y[n]",
        "h[k] = (1 - leak) * h[k] + step * x[n-k]"
      ]
    },
    {
      "dot": "emerald",
      "title": "The three rules",
      "items": [
        "Plain: step = rate * error, thus a loud signal moves the coefficients further",
        "Normalised: the step is divided by the loudness, thus the rate behaves the same way always",
        "Sign: a fixed step in the direction of the error, with no multiplication at all"
      ]
    },
    {
      "dot": "rose",
      "title": "What the module refuses",
      "items": [
        "The normalised rule is stable for any signal while the rate lies between 0 and 2",
        "Outside that it runs away whatever the signal is",
        "That is arithmetic and not judgement, thus a rate of 2 or more is refused"
      ]
    }
  ]
