  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "S = max(0, S + (x[n] - mean - slack))",
        "While the readings are ordinary, S is pushed down as often as up",
        "Once the mean has moved, every reading pushes it the same way"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why two totals",
      "items": [
        "A total that only grows upward cannot see a reading that has dropped",
        "Thus one runs for a rise and one for a fall",
        "The slack is how far a reading may sit from the mean without counting at all"
      ]
    },
    {
      "dot": "amber",
      "title": "The trade you are setting",
      "items": [
        "A smaller threshold finds the change sooner",
        "It also gives more false alarms",
        "This is the trade itself, and both directions are a real choice"
      ]
    }
