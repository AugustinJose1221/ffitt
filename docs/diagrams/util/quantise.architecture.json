        "id": "the-step",
        "label": "One line, and one loss",
        "focus": [
          "round"
        ],
        "note": "What falls between two steps has to go to one of them, and the difference is thrown away."
      },
      {
        "id": "same-size",
        "label": "The error does not shrink",
        "focus": [
          "size"
        ],
        "note": "The error is the same size whatever is done. The choices only decide what it sounds like."
      },
      {
        "id": "dither",
        "label": "Dither makes it noise",
        "focus": [
          "dith"
        ],
        "note": "Noise added before the rounding stops the error following the signal, thus averaging can remove it."
      },
      {
        "id": "shaping",
        "label": "Shaping only moves it",
        "focus": [
          "shape",
          "full"
        ],
        "note": "Noise shaping does not remove noise. A signal that already fills the band has nowhere to move it to."
      }
    ]
  },
