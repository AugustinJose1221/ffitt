  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "r[lag] = sum over n of (a[n] - mean_a) * (b[n+lag] - mean_b)",
        "How long the delay is: the lag where the answer is largest",
        "Whether a signal repeats: correlate it with itself"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "RAW is the sum; BIASED divides it by size",
        "UNBIASED divides by size minus lag, which is how many actually overlapped",
        "COEFFICIENT divides by sqrt(r_aa[0] * r_bb[0]), giving -1 to 1"
      ]
    },
    {
      "dot": "rose",
      "title": "What will catch you",
      "items": [
        "A signal that never goes below zero correlates well with itself at every lag",
        "Only COEFFICIENT takes the mean off, because it is not defined any other way",
        "A threshold holds from one recording to the next on COEFFICIENT alone"
      ]
    }
  ]
