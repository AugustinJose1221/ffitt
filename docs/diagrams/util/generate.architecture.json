    "views": [
      {
        "id": "the-trap",
        "label": "Why a square wave is a trap",
        "focus": [
          "naive",
          "fold"
        ],
        "note": "Written as ones and minus ones its edges are instant, and an instant edge holds every frequency up to infinity."
      },
      {
        "id": "harmonics",
        "label": "Built from harmonics",
        "focus": [
          "harm",
          "limit"
        ],
        "note": "Each shape is added up from its harmonics, and only those that fit below half the rate are added."
      },
      {
        "id": "nothing-folds",
        "label": "Nothing folds back",
        "focus": [
          "out"
        ],
        "note": "What is generated is the closest thing to that shape which the rate can actually hold."
      },
      {
        "id": "repeatable",
        "label": "A seed you give",
        "focus": [
          "seed"
        ],
        "note": "The noise comes from a generator whose seed the caller sets, thus a test that fails can fail the same way again."
      }
    ]
  },
