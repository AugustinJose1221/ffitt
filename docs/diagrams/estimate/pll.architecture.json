  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "error = how far the input leads or lags the loop's own oscillator",
        "frequency = frequency + integral_gain * error",
        "phase = phase + frequency + proportional_gain * error"
      ]
    },
    {
      "dot": "emerald",
      "title": "What each gain does",
      "items": [
        "The proportional gain moves the phase at once, thus it follows a step",
        "The integral gain moves the frequency, thus it follows a drift and leaves no error",
        "With the proportional term alone, a tone whose frequency has moved is always lagged"
      ]
    },
    {
      "dot": "amber",
      "title": "Why not a transform",
      "items": [
        "A transform reads a block and gives one answer for the whole of it",
        "A frequency that changes inside the block is smeared across the bins",
        "The bandwidth here is a fraction of the sample rate, and not a number of hertz"
      ]
    }
  ]
