  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "The index of the first value that is not less than the one asked for",
        "middle = (low + high) / 2, then drop the half that cannot hold it",
        "Thus the cost is log2(n) reads and not n"
      ]
    },
    {
      "dot": "emerald",
      "title": "What it takes on trust",
      "items": [
        "The list must rise, and nothing here checks that",
        "Checking would cost the n reads the search exists to avoid",
        "A list that does not rise gives an answer, and it means nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "Why the answer is always usable",
      "items": [
        "Where every value is less than the one asked for, the answer is the last index",
        "It is not one past the end",
        "Thus a caller that reads the list at the answer never reads past it"
      ]
    }
  ]
