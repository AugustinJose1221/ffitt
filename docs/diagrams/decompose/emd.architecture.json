        ],
        "note": "The whole loop runs again on what is left, thus each mode is slower than the one before it."
      },
      {
        "id": "no-model",
        "label": "Nothing is chosen in advance",
        "focus": [
          "mixing"
        ],
        "note": "The signal decides the modes. That is the strength, and mode mixing where two frequencies sit close is the weakness."
      }
