        "id": "why-not-fft",
        "label": "Why a transform cannot",
        "focus": [
          "block"
        ],
        "note": "A transform reads a block and gives one answer. A frequency that changes inside the block is smeared across the bins."
      },
      {
        "id": "the-error",
        "label": "How far apart they are",
        "focus": [
          "mix",
          "err"
        ],
        "note": "Multiplying the input by the loop's own oscillator gives a value that is nothing when the two line up."
      },
      {
        "id": "two-gains",
        "label": "Two gains, two jobs",
        "focus": [
          "prop",
          "integ"
        ],
        "note": "The proportional gain moves the phase at once. The integral gain moves the frequency and holds a drift with no error left."
      },
      {
        "id": "the-answer",
        "label": "The frequency is the answer",
        "focus": [
          "freq"
        ],
        "note": "The loop's own frequency, carried forward and corrected at every sample, is the measurement."
      }
    ]
  },
