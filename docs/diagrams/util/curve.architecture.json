  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "gaussian(x) = height * exp(-(x - centre)^2 / (2*width^2))",
        "lorentzian(x) = height / (1 + ((x - centre)/width)^2)",
        "Each is read at a place, and nothing is held between calls"
      ]
    },
    {
      "dot": "emerald",
      "title": "How they differ",
      "items": [
        "A gaussian falls away as the exponential of a square",
        "Thus it is nothing a few widths out from its centre",
        "A lorentzian falls as one over a square, and still has something left far out"
      ]
    },
    {
      "dot": "rose",
      "title": "The usual fault",
      "items": [
        "Fitting a gaussian to a peak that really has long tails",
        "The area then comes out lower than it is",
        "These are not waves; generate makes those, and they carry a rate"
      ]
    }
  ]
