    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "Euler: x = x + h*f(x)",
        "Midpoint: one probe at the half step, then use its rate",
        "Runge-Kutta: four probes, weighed 1, 2, 2, 1"
      ]
    },
    {
      "dot": "emerald",
      "title": "What each buys",
      "items": [
        "The error after one step falls as h^2, h^3 and h^5 in that order",
        "Thus halving the step buys a factor of 4, of 8, and of 32",
        "The cost is the probes: one call of f, two, or four"
      ]
    },
    {
      "dot": "amber",
      "title": "Which to take",
      "items": [
        "A model that is cheap to evaluate should take the fourth-order rule and a longer step",
        "A model that is dear should take a shorter step and a cheaper rule",
        "kalman, ekf and ukf all want a step, and nobody writes a model as one"
      ]
    }
