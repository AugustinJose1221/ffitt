  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "Predict: x = A*x + B*u, and P = A*P*A' + Q",
        "Update: K = P*C' * inverse(C*P*C' + R)",
        "x = x + K*(y - C*x), and P = (I - K*C)*P"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the gain means",
      "items": [
        "Where the measurement is noisy, R is large, K is small, and it barely moves the state",
        "Where the model is doubtful, P grows, K grows, and the measurement is followed",
        "That one matrix is the whole idea of the filter"
      ]
    },
    {
      "dot": "amber",
      "title": "What it asks of you",
      "items": [
        "The filter takes no memory while it runs",
        "Every intermediate result sits in scratch laid out at the allocation",
        "Where S cannot be inverted the update is refused, and the state is left alone"
      ]
    }
  ]
