    "views": [
      {
        "id": "two-kinds",
        "label": "Two kinds of measure",
        "focus": [
          "plain",
          "robust"
        ],
        "note": "The plain measures follow every sample. The robust ones do not move until nearly half the list is wrong."
      },
      {
        "id": "the-weakness",
        "label": "What one bad sample does",
        "focus": [
          "bad"
        ],
        "note": "One sample that is wrong moves the mean and the deviation, and moves them further the more wrong it is."
      },
      {
        "id": "the-cost",
        "label": "What robustness costs",
        "focus": [
          "order"
        ],
        "note": "The median needs the list in order. That is why the robust measures are not free."
      },
      {
        "id": "the-bridge",
        "label": "From MAD to a deviation",
        "focus": [
          "scale"
        ],
        "note": "Multiplying the median absolute deviation by 1.4826 gives a number that means what a deviation means."
      }
    ]
  },
