        "id": "the-mirror",
        "label": "The mirror of a peak",
        "focus": [
          "test"
        ],
        "note": "A valley is a sample smaller than both its neighbours. Everything said of a peak applies here upside down."
      },
      {
        "id": "the-ends",
        "label": "The ends can never be",
        "focus": [
          "ends"
        ],
        "note": "The first and the last sample have only one neighbour each, thus neither can ever be a valley."
      },
      {
        "id": "no-memory",
        "label": "It takes no memory",
        "focus": [
          "buffers"
        ],
        "note": "The indices and the values are written into buffers the caller holds."
      },
      {
        "id": "no-judgement",
        "label": "It judges nothing",
        "focus": [
          "judge"
        ],
        "note": "This finds every local minimum and judges none of them. On a noisy signal most will not be valleys in any useful sense."
      }
    ]
