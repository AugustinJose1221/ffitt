        "id": "the-fault",
        "label": "What a mean does to a peak",
        "focus": [
          "mean"
        ],
        "note": "A mean can only give a flat answer over its window, thus it makes a peak lower and wider and the height is lost."
      },
      {
        "id": "the-fit",
        "label": "A polynomial, not a flat line",
        "focus": [
          "fit",
          "middle"
        ],
        "note": "A polynomial can follow the curve of a peak, thus the height and the width come through the filter."
      },
      {
        "id": "once-only",
        "label": "Fitted once, not per sample",
        "focus": [
          "weights",
          "apply"
        ],
        "note": "A window and an order always give the same weights, thus they are worked out at the design and used for ever after."
      },
      {
        "id": "derivative",
        "label": "The slope for free",
        "focus": [
          "slope"
        ],
        "note": "The first derivative is the same fit read from another row. No new fitting is needed for it."
      }
    ]
  },
