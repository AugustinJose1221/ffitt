  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "X[k] = sum over n of x[n] * exp(-2*pi*i*k*n/size), answered at every sample",
        "For a few known frequencies only, and not the whole spectrum",
        "A watcher on a 1024 sample window holds a few dozen bytes for each frequency"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "X[n] = (X[n-1] + arrived - left) * turn",
        "Nothing in that grows with the size of the window",
        "One complex multiplication and two additions per sample, per frequency"
      ]
    },
    {
      "dot": "amber",
      "title": "What it costs you",
      "items": [
        "The window itself is still held, so the sample that left can be taken off",
        "The turn is made a little under one, thus rounding does not pile up for ever",
        "Past about log2(size) frequencies, the whole transform is cheaper"
      ]
    }
  ]
