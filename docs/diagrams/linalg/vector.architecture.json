  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "dot(a, b) = sum over i of a[i] * b[i]",
        "norm(a) = sqrt(dot(a, a))",
        "The dot is the length of one, times the length of the other, times the cosine between"
      ]
    },
    {
      "dot": "emerald",
      "title": "What that means",
      "items": [
        "It is nothing when the two stand at right angles",
        "It is the whole product when they point the same way",
        "Thus it measures how much of one vector lies along the other"
      ]
    },
    {
      "dot": "amber",
      "title": "Where it turns up again",
      "items": [
        "A finite filter is the dot of the samples with the coefficients",
        "A correlation is the dot of two signals at an offset",
        "A projection is a dot divided by a norm"
      ]
    }
