  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "sine[n] = amplitude * sin(2*pi*f*n/rate + phase)",
        "square[n] = sum over odd k, while k*f < rate/2, of sin(2*pi*k*f*n/rate)/k",
        "Only the harmonics that fit below half the rate are added"
      ]
    },
    {
      "dot": "rose",
      "title": "Why not ones and minus ones",
      "items": [
        "Written that way the edges are instant",
        "An instant edge holds every frequency up to infinity",
        "Everything above half the rate folds back onto frequencies the wave never had"
      ]
    },
    {
      "dot": "amber",
      "title": "What you get instead",
      "items": [
        "The closest thing to that shape which the rate can actually hold",
        "It looks slightly rounded on a screen, and it is right in every transform",
        "The noise takes a seed, thus a test that fails can be run again"
      ]
    }
