    "views": [
      {
        "id": "why-not",
        "label": "Why not one transform",
        "focus": [
          "signal",
          "noisy"
        ],
        "note": "One transform of a long signal gives many bins, each as noisy as the last. A longer signal buys finer bins and no more certainty."
      },
      {
        "id": "cut-up",
        "label": "Cut into blocks",
        "focus": [
          "blocks",
          "windowed"
        ],
        "note": "The signal is cut into blocks that overlap, and each block is windowed before it is transformed."
      },
      {
        "id": "averaged",
        "label": "The mean of many",
        "focus": [
          "each",
          "mean"
        ],
        "note": "The noise in a bin falls as the number of blocks grows, while the bins grow wider because a block is shorter than the signal."
      },
      {
        "id": "scaled",
        "label": "Putting the window back",
        "focus": [
          "scale",
          "out"
        ],
        "note": "U is the sum of the squares of the window. Without it the answer would depend on which window was chosen."
      }
    ]
  },
