  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "amplitude = 2 * |X[k]| / (block * coherent_gain)",
        "power = amplitude^2 / 2, and decibel = 10*log10(power)",
        "density = |X[k]|^2 / (rate * block * noise_gain)"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "Divide by the block, because a longer block gives larger numbers for the same signal",
        "Divide by the gain, because a window makes the signal smaller",
        "Double it, because half the power sits in the mirrored half a real signal drops"
      ]
    },
    {
      "dot": "rose",
      "title": "What will catch you",
      "items": [
        "Leave one correction out and the answer still looks perfectly reasonable",
        "It then means nothing outside the one program that made it",
        "The decibel answer stops at a floor, because the logarithm of nothing has no value"
      ]
    }
  ]
