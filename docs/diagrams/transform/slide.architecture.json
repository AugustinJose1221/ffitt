        "note": "A block transform answers when the block is full. goertzel answers once per block. Neither answers at every sample."
      },
      {
        "id": "one-step",
        "label": "One step per sample",
        "focus": [
          "arrived",
          "left",
          "update"
        ],
        "note": "The new total differs from the old by the sample that arrived, the sample that fell off, and one bin of turn."
      },
      {
        "id": "the-window",
        "label": "Why the buffer stays",
        "focus": [
          "ring",
          "left"
        ],
        "note": "The window is still kept, because the sample that left must be taken off. Nothing else grows with the size."
      },
      {
        "id": "the-drift",
        "label": "Why the turn shrinks",
        "focus": [
          "update",
          "damp"
        ],
        "note": "A total added to for ever would drift as rounding piles up. Each turn is a little under one, thus an old error dies away."
      }
    ]
  },
