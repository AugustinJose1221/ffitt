      {
        "id": "two-objects",
        "label": "Two objects, chained",
        "focus": [
          "interp",
          "decim"
        ],
        "note": "The module gives no single function for a ratio. The caller builds an interpolator and a decimator and feeds one to the other."
      },
      {
        "id": "no-zeros",
        "label": "No zeros are put in",
        "focus": [
          "interp"
        ],
        "note": "A zero times a coefficient is nothing, thus each output reads only every 160th coefficient and the zeros never exist."
      },
      {
        "id": "only-kept",
        "label": "Only the kept are worked out",
        "focus": [
          "decim"
        ],
        "note": "The decimator works out its filter for the one sample in 147 it keeps, and for no other."
      },
      {
        "id": "where-it-goes",
        "label": "Where the cost goes",
        "focus": [
          "middle",
          "waste"
        ],
        "note": "Every intermediate sample is made, and all but one in 147 is thrown away. A filter that knew both factors would not make them."
      }
    ]
  },
