  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "A local maximum is x[n] > x[n-1] and x[n] > x[n+1]",
        "prominence = height less the highest of the two lowest points on either side",
        "walking out until a higher peak, or the end of the signal"
      ]
    },
    {
      "dot": "rose",
      "title": "Why the simple test is not enough",
      "items": [
        "On a clean signal a local maximum is what a peak means",
        "On a real one, noise puts one every few samples",
        "A heart at 500 samples a second holds about a hundred for every beat"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why prominence and not height",
      "items": [
        "A ripple on the flank of a large peak has almost no prominence however high it stands",
        "A small peak alone in a valley has a large one",
        "Prominence does not care where the signal sits, thus a drifting level does not change it"
      ]
    }
