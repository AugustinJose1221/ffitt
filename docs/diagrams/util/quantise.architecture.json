  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = step * round(x[n] / step)",
        "A converter of 12 bits holds 4096 steps and nothing between them",
        "The error that makes is the same size whatever else is done"
      ]
    },
    {
      "dot": "emerald",
      "title": "The three bargains",
      "items": [
        "Plain: -19.8 dB, and the error follows the signal, thus it is distortion",
        "Dither: -30.9 dB in band, and the error becomes noise that averaging removes",
        "Dither and shape: -25.4 dB, moved out of the band that matters"
      ]
    },
    {
      "dot": "rose",
      "title": "What shaping cannot do",
      "items": [
        "Noise shaping does not remove noise, it MOVES it",
        "A signal that already fills the band has nowhere to move it to",
        "There, shaping makes matters worse rather than better"
      ]
    }
