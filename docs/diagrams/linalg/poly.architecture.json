  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "p(x) = c[0] + c[1]*x + c[2]*x^2 + ...",
        "The places where a polynomial crosses nothing",
        "An iir filter is two polynomials divided: the roots below are its poles"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "x = x - p(x) / p'(x), the step of Newton",
        "Taken in complex numbers, so that a root off the real line can be reached",
        "Once a root is found it is divided out and the walk starts again"
      ]
    },
    {
      "dot": "rose",
      "title": "Why the threshold is measured",
      "items": [
        "Adding up the terms loses digits to the largest of them",
        "Thus a value can be trusted only down to about that largest term times the step of the width",
        "A fixed number asks the same of terms in millions and terms in millionths"
      ]
    }
