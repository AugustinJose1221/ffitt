        "id": "two-signals",
        "label": "Two signals, not one",
        "focus": [
          "first",
          "second",
          "cross"
        ],
        "note": "psd says what one signal holds. This takes two and asks what they share."
      },
      {
        "id": "the-cross",
        "label": "The cross spectrum",
        "focus": [
          "cross",
          "averaged"
        ],
        "note": "One spectrum times the conjugate of the other. Its size is what they share, its angle is how far one stands behind."
      },
      {
        "id": "coherence",
        "label": "Coherence",
        "focus": [
          "coh",
          "ratio"
        ],
        "note": "The share, squared, against what each holds alone. Every correction stands above and below, thus all of them cancel."
      },
      {
        "id": "the-trap",
        "label": "Why one block is useless",
        "focus": [
          "blocks",
          "coh"
        ],
        "note": "Coherence of a single block is always 1, whatever the signals are. The averaging is what makes the answer mean anything."
      }
    ]
  },
