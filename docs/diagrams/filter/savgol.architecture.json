  "cards": [
    {
      "dot": "cyan",
      "title": "What it works out",
      "items": [
        "y[n] = sum over k of x[n+k] * h[k], one weighed sum",
        "A polynomial is laid through the window and read at the middle",
        "A mean can only be flat over the window, thus it flattens the peak"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the library gets there",
      "items": [
        "h = the middle row of (A' * A)^-1 * A', with a power of the offset in each column",
        "A window and an order always give the same weights, thus they are found once",
        "The first derivative is the second row of the same fit, and costs nothing more"
      ]
    },
    {
      "dot": "amber",
      "title": "What it is for",
      "items": [
        "A signal where the height and the width of a peak carry the information",
        "The result of a spectrometer, or of a chromatograph",
        "Anywhere a plain mean would smooth away the very thing being measured"
      ]
    }
  ]
