    "views": [
      {
        "id": "the-price",
        "label": "What a median costs",
        "focus": [
          "medroad"
        ],
        "note": "A median filter replaces every sample it touches. Every peak narrower than half its window is gone and the rest is flattened."
      },
      {
        "id": "one-question",
        "label": "One question per sample",
        "focus": [
          "centre",
          "spread",
          "test"
        ],
        "note": "How far does this sample stand from the middle of its window, in a spread that a wild value cannot move?"
      },
      {
        "id": "robust",
        "label": "A spread that cannot be bent",
        "focus": [
          "spread"
        ],
        "note": "The spread is the median of the distances, not their mean. The measure of normal is not bent by the fault it looks for."
      },
      {
        "id": "untouched",
        "label": "Only the guilty are replaced",
        "focus": [
          "keep",
          "out"
        ],
        "note": "A sample that passes the test is given back exactly as it arrived."
      }
    ]
  },
  "layout": {
