        "label": "A ladder, not a list",
        "focus": [
          "stage1",
          "stage2"
        ],
        "note": "Each stage holds one number and takes away whatever the stage before it could already account for."
      },
      {
        "id": "two-signals",
        "label": "Two signals travel",
        "focus": [
          "stage1",
          "held",
          "stage2"
        ],
        "note": "What is still unexplained looking forward, and the same looking back one step further, travel through the stages together."
      },
      {
        "id": "own-pace",
        "label": "Each stage learns at its own pace",
        "focus": [
          "energy",
          "move"
        ],
        "note": "The step is divided by how loud that stage has been, thus a quiet stage is not held back by a loud one."
      },
      {
        "id": "the-sum",
        "label": "A sum, not a mean",
        "focus": [
          "energy"
        ],
        "note": "The energy is a running sum over a fading past. At a factor of 0.99 it is about a hundred times the mean."
      }
    ]
  },
