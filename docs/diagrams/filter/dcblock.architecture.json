    "views": [
      {
        "id": "the-digits",
        "label": "Where the digits go",
        "focus": [
          "converter",
          "digits"
        ],
        "note": "A 24 bit converter near mid range gives eight million counts. Six of seven digits are then spent on a level that carries nothing."
      },
      {
        "id": "one-pole",
        "label": "One pole follows it",
        "focus": [
          "track",
          "level"
        ],
        "note": "The tracker moves towards the sample by a fraction of the distance, thus it follows the level and not the signal."
      },
      {
        "id": "primed",
        "label": "Primed, not started at zero",
        "focus": [
          "prime"
        ],
        "note": "Starting at zero would make the first answer a step of the whole level, larger than the signal, and slow to die away."
      },
      {
        "id": "first",
        "label": "Subtracted first of all",
        "focus": [
          "out"
        ],
        "note": "The subtraction happens before anything else, thus the rest of the chain spends its digits on the small signal alone."
      }
    ]
  },
