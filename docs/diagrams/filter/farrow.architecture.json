    "views": [
      {
        "id": "whole-is-free",
        "label": "A whole sample costs nothing",
        "focus": [
          "whole"
        ],
        "note": "Delaying by a whole number of samples is reading further back in a buffer, and ringbuf already does it."
      },
      {
        "id": "part-is-a-filter",
        "label": "A part of one is a filter",
        "focus": [
          "between",
          "poly"
        ],
        "note": "The value between two samples is not in the reading. A polynomial is laid through the samples around it and read there."
      },
      {
        "id": "the-difficulty",
        "label": "Why a new filter each time",
        "focus": [
          "mu",
          "trouble"
        ],
        "note": "The coefficients depend on the fraction asked for, thus a delay that drifts would mean designing a filter at every sample."
      },
      {
        "id": "the-structure",
        "label": "What Farrow avoids",
        "focus": [
          "fixed",
          "cheap"
        ],
        "note": "Each coefficient is itself a polynomial in the fraction. The fixed parts are found once, and a new fraction costs a few multiplications."
      }
    ]
  },
